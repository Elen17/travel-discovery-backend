# Database (Supabase)
DB_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=replace-with-your-base64-256-bit-secret
JWT_EXPIRATION_MS=900000
JWT_REFRESH_MS=604800000

# Admin token guarding privileged ops (POST /api/v1/admin/cache/reload).
# Fixed value — generate a UUID once (e.g. `uuidgen` or [guid]::NewGuid()) and
# paste it here. Send it on the call as the `jwt-token` header.
ADMIN_RELOAD_TOKEN=00000000-0000-0000-0000-000000000000

# CORS
FRONTEND_URL=http://localhost:5173

# Server
SERVER_PORT=8080

# RapidAPI — get key at https://rapidapi.com → subscribe to booking-com15
RAPIDAPI_KEY=your_rapidapi_key_here


#  Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ── Profile-image storage ────────────────────────────────────────────
# 'local' = store uploads on disk (default; no AWS needed for development)
# 's3'    = store uploads in AWS S3 (used by the prod profile)
STORAGE_PROVIDER=local

# --- Local provider (STORAGE_PROVIDER=local) ---
# Folder on disk for uploads; served at {APP_BASE_URL}/uploads/**
STORAGE_LOCAL_DIR=uploads
APP_BASE_URL=http://localhost:8080

# --- S3 provider (STORAGE_PROVIDER=s3, e.g. production) ---
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
# Leave the keys blank to use the default AWS credential chain (IAM role, profile, env)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN / custom domain serving the bucket; blank = derive from bucket + region
AWS_S3_PUBLIC_URL=